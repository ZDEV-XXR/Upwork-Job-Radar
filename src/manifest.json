{
  "manifest_version": 3,
  "name": "Upwork Job Radar",
  "version": "1.5",
  "description": "Notifies you of new Upwork jobs based on keywords.",

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.upwork.com/*"],
      "js": ["content.js"]
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/upwork48.png",
      "32": "icons/upwork48.png",
      "48": "icons/upwork48.png"
    }
  },

  "icons": {
    "16": "icons/upwork48.png",
    "48": "icons/upwork48.png",
    "128": "icons/upwork48.png"
  },

  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "notifications",
    "alarms"
  ],

  "host_permissions": [
    "https://www.upwork.com/*"
  ]
}